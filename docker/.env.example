# Docker Environment Variables for WordPress + WooCommerce Development
# Copy this file to .env and adjust values as needed

# WordPress Database Configuration
WORDPRESS_DB_HOST=db:3306
WORDPRESS_DB_USER=wp_user
WORDPRESS_DB_PASSWORD=wp_password
WORDPRESS_DB_NAME=wp_cl_data_protection

# WordPress Configuration
WORDPRESS_DEBUG=1
WORDPRESS_TABLE_PREFIX=wp_

# MySQL Root Password (for phpMyAdmin)
MYSQL_ROOT_PASSWORD=root_password

# Ports (change if conflicts)
WORDPRESS_PORT=8080
PHPMYADMIN_PORT=8081
MYSQL_PORT=3306

# Plugin Development
PLUGIN_SLUG=chilean-data-protection
PLUGIN_NAME=Chilean Data Protection (FREE)